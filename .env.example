# ─── Base de données (Neon Postgres) ───────────────────────────────────────
# DATABASE_URL : la connexion de l'application. En production elle passe par
#                HTTP — voir `src/lib/prisma.ts`, qui choisit l'adaptateur
#                d'après l'hôte. Ce pilote-là NE SAIT PAS faire de
#                transaction interactive : `src/transactionsInterdites.test.ts`
#                l'interdit dans tout `src`.
# DIRECT_URL   : la connexion directe, pour les migrations Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js (NextAuth) ────────────────────────────────────────────────────
# Généré avec : npx auth secret   (ou openssl rand -base64 33)
AUTH_SECRET="..."
# En prod, l'URL publique du site (ex: https://winorworkout.com)
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com (API & Services > Credentials)
# Redirect URI autorisée : {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID="..."
AUTH_GOOGLE_SECRET="..."

# Discord OAuth — https://discord.com/developers/applications (OAuth2)
# Redirect URI autorisée : {AUTH_URL}/api/auth/callback/discord
AUTH_DISCORD_ID="..."
AUTH_DISCORD_SECRET="..."

# Le domaine canonique de production. Le middleware y redirige en 308 toute
# adresse de déploiement Vercel : sans ça, le cookie PKCE est posé sur le
# domaine de déploiement et le rappel Google arrive sur le domaine canonique,
# ce qui donne « Invalid code verifier » et une double connexion.
# Facultatif en local, où rien ne finit par `.vercel.app`.
AUTH_CANONICAL_HOST="winorworkout.com"

# ─── Riot Games API ────────────────────────────────────────────────────────
# Sans elle, la synchronisation des parties est indisponible et le dit — les
# parties s'enregistrent à la main, et l'application Windows les détecte
# toujours par l'API locale du jeu, qui ne demande aucune clé.
RIOT_API_KEY="RGAPI-..."
# La version de Data Dragon qui sert les icônes de champion.
NEXT_PUBLIC_DDRAGON_VERSION="14.24.1"

# ─── Qui est administrateur ────────────────────────────────────────────────
# Liste d'adresses séparées par des virgules. Le panneau /admin et les dix
# routes de `api/admin` la lisent AU SERVEUR, à chaque requête.
# Sans elle, un défaut s'applique — voir `src/lib/admin.ts`.
ADMIN_EMAILS="toi@example.com"

# ─── Courriel (Resend) ─────────────────────────────────────────────────────
# CE QUI CASSE SANS ELLE, et c'est le pire de la liste : le lien de
# récupération ne part pas. C'est la SEULE porte de secours du produit, et la
# route répond « c'est envoyé » de toute façon — la réponse doit rester
# générique, sinon elle permet d'énumérer les comptes. La route dit maintenant
# que le courriel n'est pas configuré, mais il faut encore le lire.
# Le bilan hebdomadaire ne part pas non plus.
RESEND_API_KEY="re_..."

# ─── Notifications push (VAPID) ────────────────────────────────────────────
# Générées avec : npx web-push generate-vapid-keys
# Sans elles, `notifier()` rend zéro SANS RIEN TENTER : aucune notification ne
# part, le travail programmé répond 200, et seul son journal le dit.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:toi@example.com"

# ─── Déclencheurs programmés ───────────────────────────────────────────────
# Le secret partagé qui garde `/api/cron/matin`, `/api/push/programme` et
# `/api/mail/hebdo`. Il doit valoir la MÊME chose que le secret `RAPPEL_SECRET`
# du dépôt GitHub, et que `CRON_SECRET` côté Vercel — celui-ci arrive en
# `Authorization: Bearer`, et cet en-tête-là ne se choisit pas.
# Sans lui, les routes refusent tout le monde : une variable oubliée ne doit
# pas transformer un déclencheur en porte ouverte.
RAPPEL_SECRET="..."

# ─── Amorçage ──────────────────────────────────────────────────────────────
# Le secret de `/api/init`, qui sème la configuration de barème sur une base
# neuve. Sans lui la route refuse tout le monde.
INIT_SECRET="..."

# ─── Application de bureau (desktop/) ──────────────────────────────────────
# L'adresse du site que la coquille Electron ouvre. Elle sert aussi de
# frontière : `desktop/src/origine.js` compare les ORIGINES entières, jamais
# par préfixe — un domaine qui suffixe le nôtre passait pour le nôtre.
# Le défaut est le domaine de production.
LOW_BACKEND_URL="https://winorworkout.com"
