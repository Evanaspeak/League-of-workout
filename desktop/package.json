{
  "name": "win-or-workout-desktop",
  "version": "0.9.4",
  "description": "App desktop + overlay pour Win or Workout",
  "main": "src/main.js",
  "author": "Evan Tocquet <evantocquet@gmail.com>",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.winorworkout.desktop",
    "productName": "Win or Workout",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "//": "Le modèle de lecture ne peut PAS vivre dans `files` : il finirait dans app.asar, quand le code le cherche dans `resources`. Introuvable, la bibliothèque partait le télécharger et la lecture ne rendait jamais la main.",
    "extraResources": [
      { "from": "donnees", "to": "donnees" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Win or Workout",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Evanaspeak",
        "repo": "League-of-workout"
      }
    ],
    "artifactName": "Win-or-Workout-Setup-${version}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "tesseract.js": "^7.0.0"
  }
}