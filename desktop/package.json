{
  "name": "win-or-workout-desktop",
  "version": "0.5.3",
  "description": "App desktop + overlay pour Win or Workout",
  "main": "src/main.js",
  "author": "Evan Tocquet <evantocquet@gmail.com>",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.winorworkout.desktop",
    "productName": "Win or Workout",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Win or Workout",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Evanaspeak",
        "repo": "League-of-workout"
      }
    ],
    "artifactName": "Win-or-Workout-Setup-${version}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
