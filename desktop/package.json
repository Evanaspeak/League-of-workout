{
  "name": "win-or-workout-desktop",
  "version": "0.3.0",
  "description": "App desktop + overlay pour Win or Workout",
  "main": "src/main.js",
  "author": "Evan Tocquet <evantocquet@gmail.com>",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.winorworkout.desktop",
    "productName": "Win or Workout",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Win or Workout",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "directories": {
      "buildResources": "build"
    }
  }
}
