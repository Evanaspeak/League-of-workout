generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentification (Auth.js / NextAuth) ──────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Données applicatives
  pseudo        String  @default("Joueur")
  riotId        String? // format: pseudo#tag
  riotPuuid     String?
  riotRegion    String  @default("EUW1")
  gainageMaxSec Int     @default(45)

  // Connexion email/mot de passe OU pseudo/code (null pour les comptes OAuth).
  // Pour les comptes "pseudo+code", le code est haché ici et email reste null.
  passwordHash  String?

  // Infos physiques optionnelles (remplies à l'inscription si l'utilisateur veut).
  genre              String?
  age                Int?
  poids              Int?
  taille             Int?
  sportsHoursPerWeek Int?

  // Exercices choisis pour payer sa dette (pompes | squats | boxe). Quand
  // plusieurs sont sélectionnés, ils tournent à tour de rôle d'une partie à
  // l'autre. `exercice` (singulier) est l'ancienne version, conservée en base
  // le temps que tous les déploiements soient à jour — ne plus l'utiliser.
  exercice           String   @default("pompes")
  exercices          String[] @default(["pompes"])
  // Seuil de rappel pendant une session, en points d'effort. 0 = désactivé.
  // Remplacé par `rappelSeuilSec` — conservé le temps de la transition.
  rappelSeuilPoints  Int      @default(45)
  // Dette accumulée et pas encore faite, en points d'effort.
  dettePointsDus     Int      @default(0)
  // Seuil de rappel en SECONDES d'effort (300 = 5 min). 0 = désactivé.
  rappelSeuilSec     Int      @default(300)

  // Beta : rang d'inscription (1..N). Seuls les 100 premiers ont accès.
  betaRank  Int?
  createdAt DateTime @default(now())

  games    Game[]
  Goal     Goal?
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Rate-limiting login/register — une ligne par tentative, purgée après la fenêtre.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // email (login) ou IP (register)
  kind      String // "login" | "register"
  createdAt DateTime @default(now())

  @@index([key, kind, createdAt])
}

// ─── Données de jeu ─────────────────────────────────────────────────────────

model Game {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime @default(now())
  role                String // Top | Jungle | Mid | ADC | Support | ARAM | Arena
  champion            String?
  kills               Int
  deaths              Int
  assists             Int
  result              String // V | D
  gainageSec          Int
  niveauCalcule       Int
  partiesAvantCalcule Int
  surchargeCalculee   Float
  scoreCalcule        Int
  malusCalcule        Int
  // Coût en POINTS D'EFFORT (1 point = 1 pompe). Le nom est historique :
  // la quantité réellement affichée dépend de `exercice` ci-dessous.
  pompesCalculees     Int
  // Exercice actif au moment où la partie a été enregistrée. Quand la dette se
  // partage entre plusieurs exercices, c'est le premier d'entre eux.
  exercice            String   @default("pompes")
  // Ventilation de la dette entre exercices, en JSON : {"pompes":23,"boxe":23}.
  // Null quand un seul exercice est concerné — `exercice` suffit alors.
  repartition         String?
  // Jeu concerné, et façon dont il génère de la dette :
  //   "parties" → résultat et KDA (League of Legends, Valorant…)
  //   "temps"   → durée jouée, sans victoire ni défaite (Minecraft…)
  jeu                 String   @default("League of Legends")
  typeJeu             String   @default("parties")
  // Durée jouée en secondes, renseignée uniquement pour typeJeu = "temps".
  dureeSec            Int?
  // Battle royale : place finale et taille de la partie. `deaths` et `result`
  // n'y veulent rien dire — c'est le classement qui fait la performance.
  placement           Int?
  joueurs             Int?
  source              String   @default("manuel") // manuel | riot_api
  riotMatchId         String?

  @@index([userId])
  // Une partie Riot ne peut être enregistrée qu'une fois par joueur : deux
  // onglets ouverts ou un renvoi réseau ne doivent pas la facturer deux fois.
  // Les parties manuelles ont riotMatchId à null, que Postgres ne contraint
  // pas — elles restent donc librement dupliquables, ce qui est voulu.
  @@unique([userId, riotMatchId])
}

model Goal {
  id                  String @id @default(cuid())
  userId              String @unique
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectifTotalPompes Int    @default(1000)
}

// ─── Configuration de scoring (globale, partagée par tous les joueurs) ──────

model RoleWeight {
  role           String  @id // Top | Jungle | Mid | ADC | Support | ARAM | Arena
  poidsMort      Float
  poidsKill      Float
  poidsAssist    Float
  maitriseActive Boolean
}

model LevelConfig {
  niveau          Int   @id // 1-5
  seuilGainageSec Int // seuil max en secondes
  multiplicateur  Float
  malusDefaite    Int
}

model MasteryConfig {
  id             Int   @id @default(1)
  surchargeMax   Float @default(0.5)
  partiesPourMax Int   @default(100)
}

// ─── Configuration système (admin) ───────────────────────────────────────────

model SystemConfig {
  key   String @id
  value String // JSON
}

// ─── Candidatures bêta ───────────────────────────────────────────────────────

model BetaApplication {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  pseudo       String
  email        String   @unique
  riotId       String
  region       String
  genre        String
  age          Int
  poids        Int
  hoursPerWeek       String
  sportsHoursPerWeek Int    @default(0)
  currentSport       String?
  motivation         String
  discovery    String
  engagement   Int
  status       String   @default("pending") // pending | accepted | rejected
}
