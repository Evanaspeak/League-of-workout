generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentification (Auth.js / NextAuth) ──────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Données applicatives
  pseudo        String  @default("Joueur")
  riotId        String? // format: pseudo#tag
  riotPuuid     String?
  riotRegion    String  @default("EUW1")
  gainageMaxSec Int     @default(45)

  // Connexion email/mot de passe OU pseudo/code (null pour les comptes OAuth).
  // Pour les comptes "pseudo+code", le code est haché ici et email reste null.
  passwordHash  String?

  // Génération de session. Les sessions sont des jetons signés : rien en base
  // ne les représente, donc rien ne pouvait les révoquer. Réinitialiser le mot
  // de passe d'un compte compromis ne mettait personne dehors — le jeton de
  // l'intrus restait bon trente jours. Incrémenter ce compteur périme d'un coup
  // tous les jetons émis avant, et `getCurrentUser()` le vérifie à chaque appel
  // puisqu'il relit déjà la ligne.
  sessionEpoch  Int     @default(0)

  // Génération de l'intro (accueil + visite guidée). Les marques de « déjà vu »
  // vivent dans le navigateur, ce qui suffit au quotidien mais ne se commande
  // pas de l'extérieur : un administrateur ne peut pas vider le stockage local
  // de quelqu'un d'autre. Ce compteur fait partie de la clé sous laquelle elles
  // sont écrites — l'incrémenter les rend caduques d'un coup, sur tous les
  // appareils du compte, sans rien avoir à effacer.
  introGeneration Int   @default(0)

  // Infos physiques optionnelles (remplies à l'inscription si l'utilisateur veut).
  //
  // Croisées avec l'activité physique enregistrée, ce sont des données de santé
  // au sens de l'article 9 du RGPD : elles ne se traitent qu'avec un
  // consentement explicite, distinct de celui donné pour le reste du compte.
  genre              String?
  age                Int?
  poids              Int?
  taille             Int?
  sportsHoursPerWeek Int?

  // Consentement au traitement des données de santé ci-dessus.
  //
  // Deux dates plutôt qu'un booléen : il faut pouvoir distinguer trois états —
  // jamais demandé, accepté, refusé — et savoir QUAND. Un consentement sans
  // date ne se prouve pas, et c'est à nous de le prouver (art. 7.1).
  // Un refus efface les cinq champs ci-dessus ; la date du refus reste, pour
  // ne pas redemander à chaque connexion.
  santeConsentiLe DateTime?
  santeRefuseLe   DateTime?

  signalements Signalement[]
  paiements    Paiement[]

  // Depuis quand une dette non payée court. Posée quand le compteur passe de
  // zéro à positif, effacée quand il retombe à zéro. Sans elle, « en retard
  // depuis trois jours » ne se calcule pas : le compteur ne dit que combien on
  // doit, jamais depuis quand.
  detteDepuis DateTime?

  // Jeton de la source OBS : une adresse publique qui affiche la dette en
  // direct, sans session. Nul tant qu'on ne l'a pas demandé, et régénérable —
  // c'est la seule façon de révoquer un lien déjà collé dans un logiciel de
  // diffusion.
  jetonObs String? @unique

  /**
   * Le parrainage.
   *
   * `codeParrain` se tire à la demande, comme `jetonObs` : un compte qui n'a
   * jamais ouvert l'écran des amis n'en a pas, et une colonne nulle vaut mieux
   * qu'un code engendré pour tout le monde à l'inscription.
   *
   * `parrainId` ne se pose QU'À la création du compte et ne change jamais.
   * Le rouvrir permettrait de se réattribuer à quelqu'un d'autre après coup,
   * donc de faire compter une inscription deux fois. `SetNull` plutôt que
   * `Cascade` : si le parrain s'en va, le filleul reste — son compte n'a rien
   * à voir avec celui qui l'a invité.
   */
  codeParrain String? @unique
  parrainId   String?
  parrain     User?   @relation("Parrainage", fields: [parrainId], references: [id], onDelete: SetNull)
  filleuls    User[]  @relation("Parrainage")

  // Exercices mis de côté, blessure ou gêne. Ils sortent d'`exercices` — la
  // liste active, que tout le reste de l'application lit déjà — et attendent
  // ici qu'on les reprenne. Les garder à part évite de toucher aux six
  // endroits qui répartissent la dette, et donc d'en oublier un.
  exercicesSuspendus String[] @default([])
  // Depuis quand, pour pouvoir le rappeler sans le réclamer.
  suspensionDepuis   DateTime?

  // Langue choisie dans l'application ("fr", "en", "es", "de", "zh", "ja").
  //
  // Elle vivait uniquement dans le stockage du navigateur, ce que le serveur
  // ne voit pas : les notifications push partaient donc en français pour tout
  // le monde, y compris pour quelqu'un qui n'a jamais vu un écran français.
  // Nulle tant qu'aucun écran n'a eu l'occasion de la remonter.
  langue String?

  // Recevoir le bilan hebdomadaire par courriel. Un envoi récurrent sans
  // bouton d'arrêt n'est pas un service rendu, c'est une nuisance qu'on
  // s'inflige à soi-même : celui qui ne peut pas l'éteindre se désabonne de
  // tout, y compris de ce qui lui servait.
  bilanActif Boolean @default(true)

  // Date du dernier bilan hebdomadaire envoyé. Sans elle, un travail horaire
  // enverrait le même bilan vingt-quatre fois dans la journée.
  bilanLe DateTime?

  // Date du dernier rappel du matin envoyé.
  //
  // Le rappel n'en avait pas : il se contentait de partir à neuf heures pile,
  // ce qui suffit tant que le déclencheur passe toutes les heures. Il ne le
  // fait pas — trente exécutions en huit jours au lieu de cent quatre-vingt-
  // douze, et aucune à l'heure voulue. La fenêtre s'étend donc à la matinée,
  // et c'est cette date qui empêche d'envoyer trois fois entre neuf heures et
  // midi.
  rappelLe DateTime?

  // Date de la dernière relance envoyée après une absence. Sans elle, le
  // travail horaire renverrait la même relance toutes les vingt-quatre heures
  // à quelqu'un qui a précisément choisi de ne pas revenir — le moyen le plus
  // sûr de faire couper les notifications, et de le mériter.
  relanceLe DateTime?

  // Fuseau horaire du navigateur, au format IANA ("Europe/Paris").
  //
  // Le serveur ne connaît que l'heure UTC. Sans cette colonne, un rappel
  // envoyé « le matin » tombe à trois heures du matin pour une partie des
  // comptes — c'est-à-dire l'inverse d'un service rendu. Nulle tant qu'aucun
  // écran ne l'a remontée, et un rappel ne part jamais dans ce cas.
  fuseau String?

  // Variante d'exécution déclarée pour les pompes : "genoux" ou rien.
  //
  // Elle ne change AUCUN calcul — des pompes genoux au sol coûtent le même
  // nombre de points. Un ratio adapté aurait été plus juste sur le papier et
  // faux à l'usage : il aurait effacé la seule chose qu'on vient regarder.
  // Voir trois semaines d'historique annotées, puis l'annotation disparaître,
  // dit une progression qu'aucun coefficient ne dit.
  variantePompes String?

  // Exercices choisis pour payer sa dette (pompes | squats | boxe). Quand
  // plusieurs sont sélectionnés, ils tournent à tour de rôle d'une partie à
  // l'autre. `exercice` (singulier) est l'ancienne version, conservée en base
  // le temps que tous les déploiements soient à jour — ne plus l'utiliser.
  exercice           String   @default("pompes")
  exercices          String[] @default(["pompes"])
  // Seuil de rappel pendant une session, en points d'effort. 0 = désactivé.
  // Remplacé par `rappelSeuilSec` — conservé le temps de la transition.
  rappelSeuilPoints  Int      @default(45)
  // Dette accumulée et pas encore faite, en points d'effort.
  dettePointsDus     Int      @default(0)
  // Seuil de rappel en SECONDES d'effort (300 = 5 min). 0 = désactivé.
  rappelSeuilSec     Int      @default(300)
  /**
   * Que faire quand l'application détecte qu'un jeu vient de démarrer.
   *
   *   "demander" → la question s'affiche par-dessus l'écran de chargement
   *   "auto"     → la session démarre seule, comme avant
   *   "jamais"   → rien, on lance la session à la main
   *
   * Le défaut est « demander » : une session qui se lance sans qu'on l'ait
   * voulu est une surprise, et le propriétaire du produit l'a signalée comme
   * telle. L'écran de chargement est le seul instant où l'on sait qu'une
   * partie commence et où l'on n'est pas encore en jeu.
   */
  sessionAuto        String   @default("demander")
  // Volume d'effort quotidien au-delà duquel l'application prévient, en points.
  // Ce n'est pas un plafond dur : la dette continue de se calculer, on signale
  // seulement qu'on a dépassé ce qu'on s'était fixé pour la journée.
  // 0 = pas d'avertissement.
  plafondQuotidien   Int      @default(0)
  // Nombre maximum de pompes d'affilée, et date du test. C'est lui qui fixe le
  // niveau, donc le multiplicateur de la dette. 0 = jamais testé.
  // Mesurer en pompes plutôt qu'en gainage : la monnaie de l'app est la pompe,
  // et tenir la planche quatre minutes ne dit pas qu'on sait en faire dix.
  pompesMax          Int      @default(0)
  pompesMaxLe        DateTime?

  // Beta : rang d'inscription (1..N). Seuls les 100 premiers ont accès.
  betaRank  Int?
  createdAt DateTime @default(now())

  games    Game[]
  Goal     Goal?
  pushSubs PushSubscription[]
  accounts Account[]
  sessions Session[]

  // Le graphe social. Deux relations pour une seule notion : une amitié a un
  // demandeur et un receveur, et il faut savoir lequel on est pour afficher
  // « en attente de sa réponse » plutôt que « répondre ».
  amitiesEnvoyees Amitie[]       @relation("AmitiesEnvoyees")
  amitiesRecues   Amitie[]       @relation("AmitiesRecues")
  groupes         MembreGroupe[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Rate-limiting login/register — une ligne par tentative, purgée après la fenêtre.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // email (login) ou IP (register)
  kind      String // "login" | "register"
  createdAt DateTime @default(now())

  @@index([key, kind, createdAt])
}

// ─── Données de jeu ─────────────────────────────────────────────────────────

model Game {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Date de la PARTIE, éventuellement corrigée à la main après coup. */
  date                DateTime @default(now())
  /**
   * Date de l'ENREGISTREMENT, posée par le serveur et jamais modifiée.
   *
   * `date` ne peut pas servir à mesurer : une partie ajoutée à la main se
   * date dans le passé, et le délai entre l'inscription et la première partie
   * en ressortait négatif. Les deux dates disent deux choses différentes, et
   * les confondre fausse toute mesure d'usage.
   */
  createdAt           DateTime @default(now())
  role                String // Top | Jungle | Mid | ADC | Support | ARAM | Arena
  champion            String?
  kills               Int
  deaths              Int
  assists             Int
  result              String // V | D
  gainageSec          Int
  niveauCalcule       Int
  partiesAvantCalcule Int
  surchargeCalculee   Float
  scoreCalcule        Int
  malusCalcule        Int
  // Coût en POINTS D'EFFORT (1 point = 1 pompe). Le nom est historique :
  // la quantité réellement affichée dépend de `exercice` ci-dessous.
  pompesCalculees     Int
  // Exercice actif au moment où la partie a été enregistrée. Quand la dette se
  // partage entre plusieurs exercices, c'est le premier d'entre eux.
  exercice            String   @default("pompes")
  // Ventilation de la dette entre exercices, en JSON : {"pompes":23,"boxe":23}.
  // Null quand un seul exercice est concerné — `exercice` suffit alors.
  repartition         String?
  // Ratios en vigueur au moment de l'enregistrement, en JSON :
  // {"pompes":1,"boxe":6.9}. Ils disent combien de répétitions ou de secondes
  // vaut un point d'effort. Gelés ici pour la MÊME raison que `variante` et
  // `exercice` juste au-dessus, et l'oubli s'était payé cher : un ratio changé
  // dans le panneau d'administration réécrivait tout l'historique de tout le
  // monde, et une soirée qui avait coûté 4 min 25 de boxe en affichait 8 min 50.
  // Null pour les parties antérieures à cette colonne : elles retombent sur les
  // ratios d'origine, qui sont ceux sous lesquels elles ont été chiffrées.
  ratios              String?
  // Variante d'exécution en vigueur au moment de l'enregistrement ("genoux").
  // Recopiée depuis le réglage du compte plutôt que lue au moment de
  // l'affichage : le réglage change, l'historique ne doit pas changer avec.
  // Quelqu'un qui arrête les genoux au sol verrait sinon ses trois premières
  // semaines se réécrire d'un coup.
  variante            String?
  // Jeu concerné, et façon dont il génère de la dette :
  //   "parties" → résultat et KDA (League of Legends, Valorant…)
  //   "temps"   → durée jouée, sans victoire ni défaite (Minecraft…)
  jeu                 String   @default("League of Legends")
  typeJeu             String   @default("parties")
  // Durée jouée en secondes, renseignée uniquement pour typeJeu = "temps".
  dureeSec            Int?
  // Battle royale : place finale et taille de la partie. `deaths` et `result`
  // n'y veulent rien dire — c'est le classement qui fait la performance.
  placement           Int?
  joueurs             Int?
  // Rocket League : arrêts. Les buts vont dans `kills` et les passes dans
  // `assists`, qui jouent le même rôle ; il manquait une troisième case.
  arrets              Int?
  // Type de file, lu sur le lanceur League : « Classée Solo/Duo », « ARAM »…
  // Le KDA seul ne distingue pas une classée d'une partie normale.
  file                String?
  fileClassee         Boolean?
  source              String   @default("manuel") // manuel | riot_api | live_client
  riotMatchId         String?

  @@index([userId])
  // Une partie Riot ne peut être enregistrée qu'une fois par joueur : deux
  // onglets ouverts ou un renvoi réseau ne doivent pas la facturer deux fois.
  // Les parties manuelles ont riotMatchId à null, que Postgres ne contraint
  // pas — elles restent donc librement dupliquables, ce qui est voulu.
  @@unique([userId, riotMatchId])
}

/**
 * Abonnement aux notifications web d'un navigateur. Un même compte peut en
 * avoir plusieurs : le téléphone et le PC sont deux abonnements distincts.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Point de terminaison fourni par le navigateur : il identifie l'abonnement.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Goal {
  id                  String @id @default(cuid())
  userId              String @unique
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectifTotalPompes Int    @default(1000)
}

// ─── Configuration de scoring (globale, partagée par tous les joueurs) ──────

model RoleWeight {
  role           String  @id // Top | Jungle | Mid | ADC | Support | ARAM | Arena
  poidsMort      Float
  poidsKill      Float
  poidsAssist    Float
  maitriseActive Boolean
}

model LevelConfig {
  niveau          Int   @id // 1-5
  // Ancien critère, conservé pour les parties déjà enregistrées.
  seuilGainageSec Int // seuil max en secondes
  // Nombre maximum de pompes d'affilée jusqu'auquel ce niveau s'applique.
  seuilPompes     Int   @default(999)
  multiplicateur  Float
  malusDefaite    Int
}

model MasteryConfig {
  id             Int   @id @default(1)
  surchargeMax   Float @default(0.5)
  partiesPourMax Int   @default(100)
}

// ─── Configuration système (admin) ───────────────────────────────────────────

model SystemConfig {
  key   String @id
  value String // JSON
}

// ─── Paiements de dette ─────────────────────────────────────────────────────

// Une fois où la dette a été payée.
//
// Le compteur `dettePointsDus` ne dit que l'état courant : il ne garde aucune
// trace de ce qui a été fait. Sans historique, une série de jours consécutifs
// ne se calcule pas, et elle ne se rattrape pas après coup.
model Paiement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Points d'effort acquittés.
  points Int

  // Jour LOCAL du paiement, au format AAAA-MM-JJ. Le jour UTC ne convient pas :
  // quelqu'un qui paie à une heure du matin verrait sa série comptée sur la
  // veille ou le lendemain selon son fuseau.
  jour String

  /**
   * Jeton d'unicité, posé par le navigateur quand le paiement a été fait hors
   * réseau et rejoué plus tard.
   *
   * Sans lui, un renvoi paie deux fois : la file d'attente réessaie tant
   * qu'elle n'a pas reçu de réponse, et une réponse perdue en chemin est
   * indiscernable d'une requête jamais arrivée. C'est le cas normal sur un
   * téléphone qui retrouve le réseau dans un tunnel.
   *
   * Facultatif : un paiement fait en ligne n'en a pas besoin, et poser un
   * jeton à tout le monde ne ferait qu'ajouter une colonne à indexer.
   */
  jeton String? @unique

  @@index([userId, jour])
}

// ─── Signalements ───────────────────────────────────────────────────────────

/**
 * Un problème signalé depuis l'application.
 *
 * Jusqu'ici un bug se signalait par courriel, donc ne se signalait pas. Et le
 * peu qui arrivait manquait de tout : quelle page, quelle version, quel
 * navigateur, connecté ou non. On répondait par des questions.
 *
 * `userId` est facultatif — sans quoi un problème sur l'écran de connexion,
 * c'est-à-dire le pire de tous, resterait le seul qu'on ne peut pas signaler.
 */
model Signalement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /** Ce que la personne a écrit. */
  message String

  /** Page d'où le signalement part, sans paramètres de requête. */
  page String

  /**
   * Contexte joint automatiquement, en JSON : version de l'application,
   * bureau ou navigateur, langue, taille d'écran. Jamais l'adresse complète
   * ni le contenu de la page — un signalement n'est pas une capture.
   */
  contexte String

  /** ouvert | traite */
  statut String @default("ouvert")

  @@index([statut, createdAt])
}

// ─── Candidatures bêta ───────────────────────────────────────────────────────

model BetaApplication {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  pseudo       String
  email        String   @unique
  riotId       String
  region       String
  genre        String
  age          Int
  poids        Int
  hoursPerWeek       String
  sportsHoursPerWeek Int    @default(0)
  currentSport       String?
  motivation         String
  discovery    String
  engagement   Int
  status       String   @default("pending") // pending | accepted | rejected
}

// ─── Le social ───────────────────────────────────────────────────────────────

/**
 * Une amitié, demandée puis acceptée.
 *
 * **Rien n'est explorable.** Le propriétaire du produit a répondu non à
 * « es-tu prêt à modérer un espace social ? » (réponse 127), et cette réponse
 * décide de la forme : pas d'annuaire, pas de recherche, aucun texte libre
 * échangé. On ajoute quelqu'un dont on connaît déjà le pseudo, et la relation
 * n'existe que s'il l'accepte. Il n'y a donc rien à modérer : le seul contenu
 * qui circule est un pseudo, déjà validé par `validerPseudo`.
 *
 * **Un refus supprime la ligne.** Le marquer laisserait à qui insiste le moyen
 * de savoir qu'il a été refusé — et il n'y a personne pour arbitrer ce qui
 * suivrait. Refuser rend donc l'état d'avant : il pourra redemander, et ce
 * sera à nouveau une demande ordinaire.
 */
model Amitie {
  id String @id @default(cuid())

  demandeurId String
  receveurId  String

  /** attente | acceptee */
  etat String @default("attente")

  createdAt  DateTime  @default(now())
  accepteeLe DateTime?

  demandeur User @relation("AmitiesEnvoyees", fields: [demandeurId], references: [id], onDelete: Cascade)
  receveur  User @relation("AmitiesRecues", fields: [receveurId], references: [id], onDelete: Cascade)

  /**
   * Une seule ligne par couple ORIENTÉ. L'autre sens — B demande à A alors que
   * A a déjà demandé à B — n'est pas empêché par la base : c'est la route qui
   * regarde les deux sens avant d'écrire, et qui accepte au lieu de créer un
   * doublon. Un index sur un couple non ordonné n'existe pas en SQL.
   */
  @@unique([demandeurId, receveurId])
  @@index([receveurId, etat])
  @@index([demandeurId, etat])
}

/**
 * Un groupe qu'on rejoint par un code.
 *
 * Même raison que pour les amitiés : le code est la seule porte. Sans lui le
 * groupe n'existe pour personne, ce qui évite d'avoir à surveiller ce que des
 * inconnus y feraient. Le nom est validé comme un pseudo — c'est le seul texte
 * qu'un membre lira, autant qu'il passe par la règle qui existe déjà.
 */
model Groupe {
  id        String   @id @default(cuid())
  nom       String
  /** Le code d'invitation, régénérable : c'est la seule façon de le révoquer. */
  code      String   @unique
  createdAt DateTime @default(now())

  membres MembreGroupe[]
}

model MembreGroupe {
  id       String @id @default(cuid())
  groupeId String
  userId   String

  /**
   * proprietaire | membre
   *
   * Le propriétaire renomme le groupe et refait le code. Un groupe qui perd le
   * sien ne peut plus révoquer un code déjà partagé, d'où la reprise : quand
   * le propriétaire part, le plus ancien membre restant hérite du rôle.
   */
  role String @default("membre")

  createdAt DateTime @default(now())

  groupe Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupeId, userId])
  @@index([userId])
}
